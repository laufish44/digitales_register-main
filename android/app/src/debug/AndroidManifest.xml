    <application>
        <!-- Shows every home screen widget at once; debug builds only. -->
        <activity
            android:name="it.digitalesregisterapp.WidgetGalleryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />
    </application>
</manifest>